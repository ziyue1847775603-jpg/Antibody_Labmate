<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Antibody Labmate — Live Local {{ run_id }}</title>
<style>body{font-family:system-ui,sans-serif;margin:2rem;max-width:1100px;color:#19212b}h1{margin-bottom:.2rem}.badge{display:inline-block;padding:.2rem .5rem;border-radius:.3rem;background:#fff3cd;color:#664d03;font-weight:700}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #d7dce2;padding:.42rem;text-align:left;font-size:.9rem}th{background:#f4f6f8}.note{border-left:4px solid #d39e00;padding:.7rem 1rem;background:#fffaf0}code{overflow-wrap:anywhere}</style>
</head><body>
<h1>Antibody Labmate</h1><p><span class="badge">LIVE LOCAL · VERIFIED LIVE</span> Run <code>{{ run_id }}</code> · {{ created_at }}</p>
<p class="note">This report records a local computational run. Ranking is a same-run heuristic priority only. It is not evidence of binding, affinity, binding free energy, specificity, safety, efficacy, or therapeutic effect.</p>
<h2>Inputs and provenance</h2>
<ul><li>Candidate source: {{ job.source_type }}</li><li>Antigen chains: {{ antigen_summary.chains|join(', ') }}</li><li>ColabFold: <code>{{ job.tools.colabfold_batch }}</code> ({{ tool_versions.colabfold }}); MSA policy: {{ job.tools.msa_network_policy }}</li><li>LightDock: <code>{{ job.tools.lightdock_setup }}</code>, <code>{{ job.tools.lightdock_run }}</code> ({{ tool_versions.lightdock_run }})</li><li>Docking score: {{ job.docking.score_name }}; direction explicitly declared as {{ job.docking.score_direction }}</li></ul>
<h2>Candidate ranking</h2><table><tr><th>Rank</th><th>Candidate</th><th>Final heuristic score</th><th>mean pLDDT</th><th>CDR pLDDT</th><th>Docking best</th><th>CDR contact ratio</th></tr>{% for row in ranking_rows %}<tr><td>{{ row.rank }}</td><td>{{ row.candidate_id }}</td><td>{{ row.final_score }}</td><td>{{ row.mean_plddt }}</td><td>{{ row.cdr_plddt }}</td><td>{{ row.docking_best_score }}</td><td>{{ row.cdr_contact_ratio }}</td></tr>{% endfor %}</table>
<h2>Stage record</h2><table><tr><th>ID</th><th>Name</th><th>Status</th><th>Provider</th><th>Notes</th></tr>{% for stage in stages %}<tr><td>{{stage.stage_id}}</td><td>{{stage.name}}</td><td>{{stage.status}}</td><td>{{stage.provider}}</td><td>{{stage.notes|join('; ')}}</td></tr>{% endfor %}</table>
{% if warnings %}<h2>Warnings</h2><ul>{% for item in warnings %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
<h2>Input hashes</h2><table>{% for name,value in input_hashes.items() %}<tr><th>{{name}}</th><td><code>{{value}}</code></td></tr>{% endfor %}</table>
</body></html>
